<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIGNAL HISTORY"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"/>
        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/borderlessButtonStyle"
            android:text="Clear"
            android:textColor="@color/down_red"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:background="@drawable/bg_card2">
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 0 · UP: 0 · DOWN: 0 · WAIT: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tvWinRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Recorded: 0 wins / 0 losses · Win rate: —"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button android:id="@+id/filterAll" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:text="ALL" android:textSize="11sp" android:background="@drawable/bg_button_primary" android:textColor="@android:color/white"/>
        <Button android:id="@+id/filterUp" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:text="UP" android:textSize="11sp" android:background="@drawable/bg_button_outline" android:textColor="@color/text_primary"/>
        <Button android:id="@+id/filterDown" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:text="DOWN" android:textSize="11sp" android:background="@drawable/bg_button_outline" android:textColor="@color/text_primary"/>
        <Button android:id="@+id/filterWait" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginStart="4dp" android:text="WAIT" android:textSize="11sp" android:background="@drawable/bg_button_outline" android:textColor="@color/text_primary"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>

</LinearLayout>
